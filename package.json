{
	"name": "soundboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"frontend",
		"backend"
	],
	"scripts": {
		"dev": "npm run dev -w @soundboard/frontend",
		"dev:api": "npm run dev -w @soundboard/backend",
		"build": "npm run build -w @soundboard/frontend",
		"preview": "npm run preview -w @soundboard/frontend",
		"lint": "npm run lint -w @soundboard/frontend",
		"typecheck": "npm run typecheck -w @soundboard/frontend",
		"build:api": "npm run build -w @soundboard/backend",
		"typecheck:api": "npm run typecheck -w @soundboard/backend",
		"typecheck:all": "npm run typecheck && npm run typecheck:api",
		"api:check": "npm run check:connectivity -w @soundboard/backend",
		"secrets:example": "npm run secrets:example -w @soundboard/backend",
		"docs:sync": "node scripts/sync-agent-docs.mjs",
		"docs:check": "node scripts/sync-agent-docs.mjs --check"
	},
	"devDependencies": {
		"supabase": "^2.114.0",
		"tsx": "^4.23.12",
		"typescript": "^5.5.3",
		"typescript-eslint": "^8.3.0"
	}
}
