# Backend environment. Copy to backend/.env and fill in.
#
# Only non-secret wiring lives here. Every credential comes from Vault —
# see docs/target-architecture.md. The one exception is VAULT_TOKEN, which is
# the bootstrap credential and cannot itself come from Vault.

NODE_ENV=development
PORT=3001

# true  -> outside the closed environment: secrets read from backend/local_secrets/,
#          identity mocked, S3 points at local MinIO
# false -> the closed environment: secrets read from Vault
IS_BLACK_ENV=true

# Selects the Vault path for database credentials: db/postgres/<PG_ENV>
PG_ENV=dev

# --- Vault -------------------------------------------------------------------
# Required unless IS_BLACK_ENV=true. VAULT_PATH is the KV v2 mount, and the
# secret name is appended as /data/<name>.
# VAULT_PATH=https://vault.internal/v1/kv
# VAULT_TOKEN=

# How long a fetched secret is reused before being re-read. Keeps rotation
# working without paying a Vault round trip per request.
SECRET_TTL_MS=300000

# --- S3 ----------------------------------------------------------------------
# The endpoint, credentials and bucket all come from the `s3` secret.
# This is only the region the SDK insists on sending; the value is ignored by
# most on-prem object stores.
S3_REGION=us-east-1

# Rejected above this size, on both client and server.
MAX_UPLOAD_BYTES=15728640

# --- Mock identity (IS_BLACK_ENV only) ---------------------------------------
# The user_sounds.user_id the mock session owns. Set it to your Supabase user
# UUID to develop against your real board. Ignored in the closed environment,
# where identity comes from the Keycloak session.
# MOCK_USER_ID=
